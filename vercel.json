{
  "version": 2,
  "buildCommand": "yarn build",
  "outputDirectory": "out",
  "installCommand": "yarn install",
  "trailingSlash": true,
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.one-toys.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://one-toys.com/$1"
      }
    },
    {
      "src": "/info/?",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/info/(.*)",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/datetime/countdown/?",
      "status": 308,
      "headers": {
        "Location": "/datetime/"
      }
    },
    {
      "src": "/code/hls/?",
      "status": 308,
      "headers": {
        "Location": "/media/hls/"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
