{
  "version": 2,
  "buildCommand": "yarn build",
  "outputDirectory": "out",
  "installCommand": "yarn install",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.one-toys.com"
        }
      ],
      "destination": "https://one-toys.com/:path*",
      "permanent": true
    },
    {
      "source": "/info",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/info/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/info/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/datetime/countdown",
      "destination": "/datetime/",
      "permanent": true
    },
    {
      "source": "/datetime/countdown/",
      "destination": "/datetime/",
      "permanent": true
    },
    {
      "source": "/code/hls",
      "destination": "/media/hls/",
      "permanent": true
    },
    {
      "source": "/code/hls/",
      "destination": "/media/hls/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
